.DS_Store

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Node (if any tooling ends up JS-based)
node_modules/

# Build artifacts / local results
/results/
/logs/
*.log
/work/
/evaluation/evidence_log.jsonl

# OS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Node (if any tooling ends up JS-based)
node_modules/

# Build artifacts / local results
/results/
/logs/
*.log
/work/
/evaluation/evidence_log.jsonl
/cfs-app/build-output/
/fprime-app/build-output/
# Second, independent rebuild used for reproducibility verification only
# (see Implementation-Plan.md Phase 7 "reproducibility verification") —
# never the artifact the pipeline actually points at.
/cfs-app/build-output-verify/
/fprime-app/build-output-verify/

# Runtime artifacts from actually executing the real cFS binary
# (core-cpu1 writes these to its current working directory — critical
# data store key files and a simulated EEPROM image, not project files)
.cdskeyfile
.reservedkeyfile
.resetkeyfile
EEPROM.DAT
*.bin
*.o
*.sig
.pytest_cache/

# Local secrets / keys — never commit real or test signing material
*.pem
*.key
secrets/

# Phase 8 (2026-08-04): state_integrity.py's HMAC sidecars, and the
# revocation-list text files they protect — local, constantly-changing
# test/dev state (revoked-key fingerprints, integrity tags), not project
# source. keys/revoked_keys.txt was already tracked from an earlier
# commit before this convention existed; see STATUS.md for the one-time
# `git rm --cached` cleanup note.
*.hmac
keys/revoked_keys.txt
keys/attestation_revoked_keys.txt

# Submission deliverables (2026-08-18): generated binary artifacts
# (.docx/.pdf/.tiff) derived from docs/Paper-Draft.md, not project
# source — regeneratable from the draft plus the docx/pdf skills.
# Also contains the author's full postal address on the manuscript
# title page, which should not land in a repo that goes public at
# paper-publication time (see README.md "Status").
/Academic Paper Submission/

# Peer-review correspondence and the superseded submitted draft (2026-11-08):
# reviewer comments are confidential until the paper is accepted, and the
# submitted v1 is superseded. Kept locally only.
/docs/Revision-1-Response.md
/docs/Paper-Draft-v1-submitted.md
